{
  "name": "slink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute slink-db --local --file=schema.sql",
    "lint": "eslint src test e2e eslint.config.mjs vitest.config.ts playwright.config.ts",
    "format": "prettier --ignore-unknown --write 'src/**/*.{ts,tsx}' 'test/**/*.ts' 'e2e/**/*.ts' 'spec/**/*.feature' '*.md' 'eslint.config.mjs' 'vitest.config.ts' 'playwright.config.ts' 'package.json' 'package-lock.json' 'wrangler.toml' 'lefthook.yml' 'schema.sql' '.github/workflows/*.yml'",
    "format:check": "prettier --ignore-unknown --check 'src/**/*.{ts,tsx}' 'test/**/*.ts' 'e2e/**/*.ts' 'spec/**/*.feature' '*.md' 'eslint.config.mjs' 'vitest.config.ts' 'playwright.config.ts' 'package.json' 'package-lock.json' 'wrangler.toml' 'lefthook.yml' 'schema.sql' '.github/workflows/*.yml'",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "hono": "^4.12.9",
    "nanoid": "^5.1.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@vitest/coverage-istanbul": "^4.1.9",
    "eslint": "^10.1.0",
    "lefthook": "^2.1.4",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.76.0"
  }
}
